@model List<TP_School.Models.Message>
@{
    ViewData["Title"] = "Сообщения";
    string currentFilter = ViewBag.Filter as string;
    string filter = string.IsNullOrEmpty(currentFilter) ? "inbox" : currentFilter;
    var recipientRoles = ViewBag.RecipientRoles as List<string> ?? new List<string>();
}

<link rel="stylesheet" href="~/css/messages.css" asp-append-version="true" />
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.3/themes/base/jquery-ui.css">

<div class="messages-page-content">

    @* Отображение сообщений TempData после редиректа (успех/ошибка) *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-error">
            @TempData["ErrorMessage"]
        </div>
    }

    <a href="#" id="openNewMessageModal" class="btn-new-message">
        <i class="fas fa-plus"></i> Новое сообщение
    </a>

    <div class="message-content-box">

        <div class="message-tabs-header">
            <a href="@Url.Action("Index", new { filter = "inbox" })"
               class="message-tab @(filter == "inbox" ? "active" : "")">Входящие</a>

            <a href="@Url.Action("Index", new { filter = "sent" })"
               class="message-tab @(filter == "sent" ? "active" : "")">Отправленные</a>

            <a href="@Url.Action("Index", new { filter = "archive" })" @* 👈 НОВАЯ ВКЛАДКА АРХИВ *@
               class="message-tab @(filter == "archive" ? "active" : "")">Архив</a>
        </div>

        <div class="message-list-container">

            @if (!Model.Any())
            {
                <p class="empty-list-message">Нет @(filter == "inbox" ? "входящих" : filter == "sent" ? "отправленных" : "архивированных") сообщений.</p>
            }
            else
            {
                <div class="message-list-header">
                    <div class="message-header-fio">@(filter == "inbox" || filter == "archive" ? "Отправитель" : "Получатель")</div>
                    <div class="message-header-text">Сообщение</div>
                    <div class="message-header-status">Статус</div>
                    <div class="message-header-actions">Действия</div>
                </div>

                @foreach (var message in Model)
                {
                    // Определяем данные для ответа (получатель ответа - это отправитель текущего сообщения)
                    var replyUserId = message.FromUser?.UserId ?? 0;
                    var replyUserName = message.FromUser?.FullName ?? "Неизвестно";

                    <div class="message-row @(message.Status == TP_School.Models.MessageStatus.New && filter == "inbox" ? "is-new" : "")">
                        @* Класс для визуального выделения нового *@

                        <div class="message-user">
                            @(filter == "inbox" || filter == "archive" ? message.FromUser?.FullName : message.ToUser?.FullName)
                        </div>

                        <div class="message-snippet" title="@message.MessageText">
                            @message.MessageText
                        </div>
                        <div class="message-status">
                            @if (message.Status == TP_School.Models.MessageStatus.New)
                            {
                                <span class="status-new">Новое</span>
                            }
                            else if (message.Status == TP_School.Models.MessageStatus.Read)
                            {
                                <span class="status-read">Прочитано</span>
                            }
                            else // MessageStatus.Archived
                            {
                                <span class="status-archived">Архив</span>
                            }
                        </div>

                        <div class="message-actions">

                            @if (filter == "inbox") // Только для ВХОДЯЩИХ
                            {
                                // Кнопка "Ответить" всегда
                                <button type="button" class="btn-action btn-reply"
                                        data-user-id="@replyUserId"
                                        data-user-name="@replyUserName">
                                    Ответить
                                </button>

                                @* 1. Кнопка "Прочитано" -> только если статус НОВЫЙ *@
                                @if (message.Status == TP_School.Models.MessageStatus.New)
                                {
                                    <form asp-action="MarkAsRead" asp-route-id="@message.MessageId" method="post" class="inline-form-action">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-action btn-read">
                                            Прочитано
                                        </button>
                                    </form>
                                }

                                @* 2. Кнопка "Архивировать" -> только если статус ПРОЧИТАНО *@
                                else if (message.Status == TP_School.Models.MessageStatus.Read)
                                {
                                    <form asp-action="Archive" asp-route-id="@message.MessageId" method="post" class="inline-form-action">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-action btn-archive">
                                            Архивировать
                                        </button>
                                    </form>
                                }
                            }

                            @* Логика удаления (только для отправленных и только Новое) *@
                            @if (filter == "sent" && message.Status == TP_School.Models.MessageStatus.New)
                            {
                                <form asp-action="Delete" asp-route-id="@message.MessageId" method="post" class="inline-form-action">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-action btn-delete" title="Удалить сообщение"
                                            onclick="return confirm('Вы уверены, что хотите удалить это сообщение?');">
                                        Удалить
                                    </button>
                                </form>
                            }

                            @* Логика восстановления из архива (только в архиве) *@
                            @if (filter == "archive")
                            {
                                <form asp-action="Restore" asp-route-id="@message.MessageId" method="post" class="inline-form-action">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-action btn-restore" title="Восстановить из архива">
                                        Восстановить
                                    </button>
                                </form>
                            }

                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@* ... (Модальное окно newMessageModal - без изменений) ... *@

<div id="newMessageModal" class="modal-overlay">
    <div class="modal-content-form">

        <div class="modal-form-header">
            Новое сообщение
        </div>

        <form id="messageForm" method="post" asp-action="Create" asp-controller="Messages">
            @Html.AntiForgeryToken() @* Обязательный токен для защиты формы *@

            <input type="hidden" name="RecipientId" id="hiddenToUserId" required />

            <select id="recipientRole" class="form-select-field recipient-input" required>
                <option value="" disabled selected>Выберите роль получателя</option>
                @foreach (var roleName in recipientRoles)
                {
                    <option value="@roleName">@roleName</option>
                }
            </select>

            <input type="text" id="recipientSearch" name="RecipientName"
                   class="form-input-field recipient-input"
                   placeholder="ФИО (начните вводить после выбора роли)"
                   disabled required>
            <div id="recipientValidationMessage" class="validation-message"></div>

            <textarea id="messageText" name="Body"
                      class="form-textarea-field"
                      placeholder="Текст сообщения"
                      rows="6" required></textarea>

            <div class="modal-form-actions">
                <button type="button" id="closeNewMessageModal" class="btn btn-secondary-text">Отмена</button>
                <button type="submit" id="sendMessageButton" class="btn btn-primary-blue" disabled>Отправить</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.3/jquery-ui.min.js"></script>
    <script>
        // Инициализация элементов
        const modal = document.getElementById('newMessageModal');
        const openNewMsgBtn = document.getElementById('openNewMessageModal');
        const closeBtn = document.getElementById('closeNewMessageModal');
        const replyButtons = document.querySelectorAll('.btn-reply');

        const roleSelect = document.getElementById('recipientRole');
        const searchInput = document.getElementById('recipientSearch');
        const validationMsg = document.getElementById('recipientValidationMessage');
        const sendButton = document.getElementById('sendMessageButton');
        const hiddenToUserId = document.getElementById('hiddenToUserId');
        const messageTextarea = document.getElementById('messageText');
        const messageForm = document.getElementById('messageForm');

        // --- Вспомогательные функции ---

        function prepareModal(isReply = false, userId = '', userName = '') {
            document.getElementById('messageForm').reset();
            validationMsg.textContent = '';
            validationMsg.className = 'validation-message';
            messageTextarea.value = '';

            // Сброс полей роли и поиска
            roleSelect.selectedIndex = 0;
            searchInput.value = '';
            searchInput.disabled = true;

            // Уничтожаем Autocomplete при открытии модального окна для "Новое сообщение"
            if ($(searchInput).data('ui-autocomplete')) {
                $(searchInput).autocomplete('destroy');
            }

            if (isReply) {
                // Режим "Ответить":
                searchInput.value = userName;
                hiddenToUserId.value = userId;
                searchInput.readOnly = true;
                roleSelect.disabled = true;
                searchInput.disabled = false;

                validationMsg.textContent = 'Ответ пользователю: ' + userName;
                validationMsg.className = 'validation-message text-green-500';
                sendButton.disabled = messageTextarea.value.trim().length === 0;
            } else {
                // Режим "Новое сообщение":
                hiddenToUserId.value = '';
                searchInput.readOnly = false;
                roleSelect.disabled = false;
                sendButton.disabled = true;
            }
            modal.style.display = 'flex';
        }

        function checkFormValidity() {
            const hasRecipient = hiddenToUserId.value !== '';
            const hasText = messageTextarea.value.trim().length > 0;
            sendButton.disabled = !(hasRecipient && hasText);
        }

        // --- Логика Autocomplete ---

        function initAutocomplete() {
            // Если уже инициализирован, просто возвращаемся
            if ($(searchInput).data('ui-autocomplete')) return;

            $(searchInput).autocomplete({
                source: function(request, response) {
                    const role = roleSelect.value;
                    const term = request.term;

                    // Если роль не выбрана
                    if (!role) {
                        validationMsg.textContent = 'Сначала выберите роль получателя.';
                        validationMsg.className = 'validation-message text-gray-500';
                        return response([]);
                    }

                    // Если поле пустое, не ищем (но Autocomplete разрешит показать пустой список)
                    if (term.length < 1) {
                        validationMsg.textContent = 'Начните вводить ФИО получателя.';
                        validationMsg.className = 'validation-message text-gray-500';
                        return response([]);
                    }

                    // Показываем индикатор поиска
                    validationMsg.textContent = 'Поиск...';
                    validationMsg.className = 'validation-message text-gray-500';
                    hiddenToUserId.value = ''; // Сбрасываем ID при новом вводе
                    checkFormValidity();

                    // Выполняем AJAX-запрос к контроллеру
                    $.ajax({
                        url: '@Url.Action("SearchUser", "Messages")',
                        dataType: "json",
                        data: {
                            fullName: term,
                            role: role
                        },
                        success: function(data) {
                            if (data && data.length > 0) {
                                validationMsg.textContent = 'Выберите получателя из списка.';
                                validationMsg.className = 'validation-message text-gray-500';
                                response($.map(data, function(item) {
                                    return {
                                        label: item.fullName + ' (' + role + ')', // Отображаемое значение в списке
                                        value: item.fullName, // Значение, которое подставится в поле
                                        userId: item.userId      // ID пользователя
                                    };
                                }));
                            } else {
                                validationMsg.textContent = 'Пользователи не найдены среди ' + role + '.';
                                validationMsg.className = 'validation-message text-red-500';
                                response([]);
                            }
                        },
                        error: function() {
                            validationMsg.textContent = 'Произошла ошибка сети/сервера.';
                            validationMsg.className = 'validation-message text-red-500';
                            response([]);
                        }
                    });
                },
                minLength: 1,
                select: function(event, ui) {
                    // Обработка выбора элемента из списка
                    hiddenToUserId.value = ui.item.userId; // Сохраняем ID
                    searchInput.value = ui.item.value;      // Устанавливаем полное ФИО
                    validationMsg.textContent = 'Получатель найден: ' + ui.item.value;
                    validationMsg.className = 'validation-message text-green-500';
                    checkFormValidity();
                    return false; // Предотвращаем стандартную обработку
                }
            });
        }

        // --- Обработчики событий ---

        // 1. При изменении роли - активируем поиск и инициализируем Autocomplete
        roleSelect.onchange = function() {
            // Очищаем предыдущие результаты поиска и разрешаем ввод ФИО
            searchInput.value = '';
            hiddenToUserId.value = '';
            searchInput.disabled = false;
            searchInput.readOnly = false;
            validationMsg.textContent = 'Введите ФИО...';
            validationMsg.className = 'validation-message text-gray-500';
            checkFormValidity();

            initAutocomplete(); // Инициализация Autocomplete
            searchInput.focus();
        };

        // 2. Сброс ID при ручном вводе
        searchInput.oninput = function() {
            if (!searchInput.readOnly) {
                hiddenToUserId.value = '';
                checkFormValidity();
            }
        };


        // 3. Остальные обработчики
        openNewMsgBtn.onclick = function() { prepareModal(false); }
        closeBtn.onclick = function() { modal.style.display = 'none'; }
        window.onclick = function(event) { if (event.target == modal) { modal.style.display = 'none'; } }
        messageTextarea.oninput = checkFormValidity;
        replyButtons.forEach(button => {
            button.onclick = function() {
                const userId = this.getAttribute('data-user-id');
                const userName = this.getAttribute('data-user-name');
                prepareModal(true, userId, userName);
                messageTextarea.focus();
            };
        });

    </script>
}
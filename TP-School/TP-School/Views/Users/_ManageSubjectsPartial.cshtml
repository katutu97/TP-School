@model List<TP_School.Models.Subject>

<h4 class="font-semibold mb-1 border-b pb-2 text-gray-700">Список существующих предметов</h4>

<div class="space-y-2 max-h-60 overflow-y-auto border p-3 rounded-lg bg-gray-50 mb-2">
    @if (!Model.Any())
    {
        <p class="text-gray-500">Предметы не найдены.</p>
    }
    @foreach (var subject in Model)
    {
        <div class="flex justify-between items-center p-2 bg-white border rounded-md shadow-sm" id="subject-item-@subject.SubjectId">
            <span class="text-sm font-medium">@subject.SubjectName</span>
            <button type="button" data-subject-id="@subject.SubjectId" class="text-red-500 hover:text-red-700 delete-subject-btn p-1 transition duration-150">
                <i class="fas fa-trash"></i>
            </button>
        </div>
    }
</div>

<h4 class="font-semibold mt-4 mb-3 border-b pb-2 text-gray-700">Добавить новый предмет</h4>
<form id="addSubjectForm" class="flex gap-4 items-end bg-white p-4 border rounded-lg shadow-inner">
    @Html.AntiForgeryToken()
    <div class="flex-grow">
        <label for="subjectNameInput" class="block text-sm font-medium text-gray-700">Название предмета</label>
        <input type="text" id="subjectNameInput" name="subjectName" class="form-input-field w-full border border-gray-300 p-2 rounded-md focus:ring-blue-500 focus:border-blue-500" required />
    </div>
    <button type="submit" class="btn-primary-blue bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-md transition duration-150 h-10">
        <i class="fas fa-plus mr-1"></i> Добавить
    </button>
</form>
<p id="addSubjectMessage" class="mt-2 text-sm hidden p-2 rounded-md border"></p>

<script>
    // ---------------------------------------------------
    // ЛОГИКА ДОБАВЛЕНИЯ ПРЕДМЕТА
    // ---------------------------------------------------
    $('#addSubjectForm').on('submit', function(e) {
        e.preventDefault();
        const $form = $(this);
        const messageBox = $('#addSubjectMessage');

        messageBox.removeClass('hidden text-red-500 text-green-500').text('');

        $.ajax({
            url: '@Url.Action("AddSubject", "Users")',
            type: 'POST',
            data: $form.serialize(),
            success: function(response) {
                // Если успешно, показываем сообщение и перезагружаем страницу
                messageBox.removeClass('hidden text-red-500').addClass('text-green-500').text(`Предмет '${response.subjectName}' успешно добавлен.`);

                // Перезагрузка страницы для обновления списков
                setTimeout(function() {
                     location.reload();
                }, 1000);
            },
            error: function(xhr) {
                let error;
                try {
                    // Используем .responseJSON, если AJAX возвращает JSON
                    error = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : xhr.responseText;
                } catch {
                    error = "Произошла ошибка сервера.";
                }
                messageBox.removeClass('hidden text-green-500').addClass('text-red-500').text(error || 'Произошла ошибка.');
            }
        });
    });

    // ---------------------------------------------------
    // ЛОГИКА УДАЛЕНИЯ ПРЕДМЕТА
    // ---------------------------------------------------
    $(document).on('click', '.delete-subject-btn', function() {
        const subjectId = $(this).data('subject-id');
        const subjectName = $(this).closest('div').find('span').text().trim();

        if (!confirm(`Вы уверены, что хотите удалить предмет "${subjectName}"?`)) {
            return;
        }

        const messageBox = $('#addSubjectMessage'); // Используем то же окно для сообщений

        $.ajax({
            url: '@Url.Action("DeleteSubject", "Users")',
            type: 'POST',
            data: { subjectId: subjectId, "__RequestVerificationToken": $('[name="__RequestVerificationToken"]').val() },
            success: function(response) {
                // Визуально удаляем элемент списка без перезагрузки
                $(`#subject-item-${subjectId}`).slideUp(200, function() {
                    $(this).remove();
                });

                messageBox.removeClass('hidden text-red-500').addClass('text-green-500').text(response.message);

                // Опционально: перезагрузка через секунду, если нужно обновить весь модал
                /*
                setTimeout(function() {
                     location.reload();
                }, 1000);
                */
            },
            error: function(xhr) {
                let error;
                try {
                    error = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : xhr.responseText;
                } catch {
                    error = "Произошла ошибка при удалении предмета.";
                }
                messageBox.removeClass('hidden text-green-500').addClass('text-red-500').text(error || 'Произошла ошибка.');
            }
        });
    });
</script>
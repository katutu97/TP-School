@model TP_School.ViewModels.StudentGradesViewModel
@{
    ViewData["Title"] = "Успеваемость";
}

<style>
    /* Стили для глобальных тултипов */
    .tooltip-container {
        position: relative;
        display: inline-block;
    }

    /* Стили для самого тултипа, который будет создаваться динамически */
    .global-tooltip {
        position: fixed;
        z-index: 99999;
        background-color: #1f2937; /* bg-gray-800 */
        color: white;
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        max-width: 400px;
        min-width: 320px;
        white-space: normal;
        word-wrap: break-word;
        overflow-wrap: break-word;
        pointer-events: none;
        visibility: hidden;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

        .global-tooltip.show {
            visibility: visible;
            opacity: 1;
        }

        .global-tooltip .tooltip-arrow {
            position: absolute;
            width: 0;
            height: 0;
            border-left: 8px solid transparent;
            border-right: 8px solid transparent;
            border-top: 8px solid #1f2937;
            bottom: -8px;
            left: 50%;
            transform: translateX(-50%);
        }

    /* Адаптация для мобильных устройств */
    @@media (max-width: 768px) {
        .global-tooltip {
            max-width: 95vw;
            min-width: 280px;
        }
    }

    @@media (max-width: 480px) {
        .global-tooltip {
            max-width: 90vw;
            min-width: 250px;
        }
    }
</style>

@* Блок для сортировки по периоду *@
<div class="bg-white rounded-lg shadow p-4 mb-4">
    <form asp-action="Index" method="get">
        <div class="flex items-center space-x-4">
            <div class="flex items-center space-x-2">
                <label for="quarter" class="text-sm font-medium text-gray-700">Период:</label>
                <select name="quarter" id="quarter" onchange="this.form.submit()"
                        class="pl-3 pr-10 py-1 text-base border-gray-300 focus:outline-none focus:ring-primary focus:border-primary sm:text-sm rounded-md">
                    @foreach (var q in Model.AvailableQuarters)
                    {
                        <option value="@q" selected="@(Model.SelectedQuarter == q)">
                            @if (q == "Итоговые оценки")
                            {
                                <span>@q</span>
                            }
                            else
                            {
                                <span>@q Четверть</span>
                            }
                        </option>
                    }
                </select>
            </div>
            <input type="hidden" name="classId" value="" />
            <input type="hidden" name="subjectId" value="" />
        </div>
    </form>
</div>

@* Информация об ученике *@
<div class="bg-white rounded-lg shadow p-4 mb-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <p class="text-sm text-gray-600">Ученик:</p>
            <p class="text-lg font-semibold">@Model.StudentFullName</p>
        </div>
        <div>
            <p class="text-sm text-gray-600">Класс:</p>
            <p class="text-lg font-semibold">@Model.ClassName</p>
        </div>
    </div>
</div>

@* Таблица с данными *@
<div class="bg-white rounded-lg shadow overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    №
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Предмет
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    @if (Model.SelectedQuarter == "Итоговые оценки")
                    {
                        <span>Ср. балл итоговых (Год)</span>
                    }
                    else
                    {
                        <span>Средний балл (Четверть)</span>
                    }
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    @if (Model.SelectedQuarter == "Итоговые оценки")
                    {
                        <span class="font-bold">Годовая Оценка</span>
                    }
                    else
                    {
                        <span class="font-bold">Итоговая Оценка</span>
                    }
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Пропуски
                </th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
            @if (Model.Subjects.Any())
            {
                var counter = 1;
                @foreach (var item in Model.Subjects)
                {
                    <tr class="hover:bg-gray-100 transition-colors">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                            @counter
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                            @item.SubjectName
                        </td>

                        @* Ячейка со средним баллом и тултипом *@
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-bold
                                @(item.QuarterFinalGrade >= 4.0 ? "text-green-600" : (item.QuarterFinalGrade >= 3.0 ? "text-yellow-600" : "text-red-600"))">
                            @if (item.GradeCount > 0)
                            {
                                <span class="tooltip-trigger cursor-help hover:underline transition-colors inline-block"
                                      data-tooltip-type="grades"
                                      data-subject-name="@item.SubjectName"
                                      data-average-grade="@item.AverageGrade.ToString("F2")"
                                      data-final-grade="@item.QuarterFinalGrade"
                                      data-grade-count="@item.GradeCount"
                                      data-all-grades="@item.AllGradesString"
                                      data-grade5="@item.GradeCount5"
                                      data-grade4="@item.GradeCount4"
                                      data-grade3="@item.GradeCount3"
                                      data-grade2="@item.GradeCount2"
                                      data-grade1="@item.GradeCount1"
                                      data-grade0="@item.GradeCount0"
                                      data-percent5="@item.Percent5.ToString("F1")"
                                      data-percent4="@item.Percent4.ToString("F1")"
                                      data-percent3="@item.Percent3.ToString("F1")"
                                      data-percent2="@item.Percent2.ToString("F1")"
                                      data-percent1="@item.Percent1.ToString("F1")"
                                      data-percent0="@item.Percent0.ToString("F1")">
                                    @item.AverageGrade.ToString("F2")
                                    <span class="text-xs text-gray-400 ml-1">(наведите для деталей)</span>
                                </span>
                            }
                            else
                            {
                                @item.AverageGrade.ToString("F2")
                            }
                        </td>

                        <td class="px-6 py-4 whitespace-nowrap font-extrabold text-lg @(item.QuarterFinalGrade < 3 ? "text-red-600" : "text-green-600")">
                            @item.QuarterFinalGrade
                        </td>

                        @* Ячейка с пропусками и тултипом *@
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            @if (item.TotalAbsences > 0)
                            {
                                <span class="tooltip-trigger cursor-help hover:text-blue-600 transition-colors inline-block"
                                      data-tooltip-type="absences"
                                      data-subject-name="@item.SubjectName"
                                      data-total-absences="@item.TotalAbsences"
                                      data-absent-h="@item.AbsentTypeH"
                                      data-absent-u="@item.AbsentTypeU"
                                      data-absent-b="@item.AbsentTypeB"
                                      data-total-lessons="@item.TotalLessonsInPeriod">
                                    @item.TotalAbsences
                                    <span class="text-xs text-gray-400 ml-1">(наведите для деталей)</span>
                                </span>
                            }
                            else
                            {
                                @item.TotalAbsences
                            }
                        </td>
                    </tr>
                    counter++;
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="px-6 py-4 text-center text-gray-500">
                        Нет данных об успеваемости или вы не привязаны к классу.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* Глобальный тултип (будет создан динамически) *@
<div id="globalTooltip" class="global-tooltip"></div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Обработка изменения селекта
            document.getElementById('quarter').addEventListener('change', function () {
                this.form.submit();
            });

            // Создаем глобальный тултип, если его нет
            let tooltip = document.getElementById('globalTooltip');
            if (!tooltip) {
                tooltip = document.createElement('div');
                tooltip.id = 'globalTooltip';
                tooltip.className = 'global-tooltip';
                document.body.appendChild(tooltip);
            }

            let tooltipVisible = false;
            let currentTrigger = null;

            // Обработчики для тултипов с оценками
            const gradeTriggers = document.querySelectorAll('.tooltip-trigger[data-tooltip-type="grades"]');
            const absenceTriggers = document.querySelectorAll('.tooltip-trigger[data-tooltip-type="absences"]');

            const allTriggers = [...gradeTriggers, ...absenceTriggers];

            allTriggers.forEach(trigger => {
                // При наведении
                trigger.addEventListener('mouseenter', function (e) {
                    currentTrigger = this;
                    const type = this.getAttribute('data-tooltip-type');

                    let tooltipContent = '';

                    if (type === 'grades') {
                        // Генерируем контент для оценок
                        const subjectName = this.getAttribute('data-subject-name');
                        const averageGrade = this.getAttribute('data-average-grade');
                        const finalGrade = this.getAttribute('data-final-grade');
                        const gradeCount = this.getAttribute('data-grade-count');
                        const allGrades = this.getAttribute('data-all-grades');

                        tooltipContent = `
                                            <div class="font-semibold mb-2 border-b pb-1 border-gray-700">Детализация оценок по предмету:</div>
                                            <div class="text-gray-300 mb-1">${subjectName}</div>
                                            <div class="mb-2">
                                                <div class="text-gray-300 mb-1">Всего оценок: <span class="font-bold text-white">${gradeCount}</span></div>
                                                <div class="text-sm text-gray-400 mb-2">Все оценки: <span class="font-bold">[${allGrades}]</span></div>
                                            </div>
                                            <div class="space-y-2 mb-3">
                                                <div class="flex justify-between items-center">
                                                    <div class="flex items-center">
                                                        <span class="w-4 h-4 bg-green-500 rounded mr-2"></span>
                                                        <span>Отлично (5):</span>
                                                    </div>
                                                    <div class="flex items-center space-x-3">
                                                        <span class="font-bold">${this.getAttribute('data-grade5')}</span>
                                                        <span class="text-xs text-gray-400">(${this.getAttribute('data-percent5')}%)</span>
                                                    </div>
                                                </div>
                                                <div class="flex justify-between items-center">
                                                    <div class="flex items-center">
                                                        <span class="w-4 h-4 bg-blue-500 rounded mr-2"></span>
                                                        <span>Хорошо (4):</span>
                                                    </div>
                                                    <div class="flex items-center space-x-3">
                                                        <span class="font-bold">${this.getAttribute('data-grade4')}</span>
                                                        <span class="text-xs text-gray-400">(${this.getAttribute('data-percent4')}%)</span>
                                                    </div>
                                                </div>
                                                <div class="flex justify-between items-center">
                                                    <div class="flex items-center">
                                                        <span class="w-4 h-4 bg-yellow-500 rounded mr-2"></span>
                                                        <span>Удовлетворительно (3):</span>
                                                    </div>
                                                    <div class="flex items-center space-x-3">
                                                        <span class="font-bold">${this.getAttribute('data-grade3')}</span>
                                                        <span class="text-xs text-gray-400">(${this.getAttribute('data-percent3')}%)</span>
                                                    </div>
                                                </div>
                                                <div class="flex justify-between items-center">
                                                    <div class="flex items-center">
                                                        <span class="w-4 h-4 bg-red-500 rounded mr-2"></span>
                                                        <span>Неудовлетворительно (2):</span>
                                                    </div>
                                                    <div class="flex items-center space-x-3">
                                                        <span class="font-bold">${this.getAttribute('data-grade2')}</span>
                                                        <span class="text-xs text-gray-400">(${this.getAttribute('data-percent2')}%)</span>
                                                    </div>
                                                </div>`;

                        const grade1 = this.getAttribute('data-grade1');
                        if (grade1 > 0) {
                            tooltipContent += `
                                                <div class="flex justify-between items-center">
                                                    <div class="flex items-center">
                                                        <span class="w-4 h-4 bg-red-700 rounded mr-2"></span>
                                                        <span>Очень плохо (1):</span>
                                                    </div>
                                                    <div class="flex items-center space-x-3">
                                                        <span class="font-bold">${grade1}</span>
                                                        <span class="text-xs text-gray-400">(${this.getAttribute('data-percent1')}%)</span>
                                                    </div>
                                                </div>`;
                        }

                        const grade0 = this.getAttribute('data-grade0');
                        if (grade0 > 0) {
                            tooltipContent += `
                                                <div class="flex justify-between items-center">
                                                    <div class="flex items-center">
                                                        <span class="w-4 h-4 bg-gray-700 rounded mr-2"></span>
                                                        <span>Нулевые (0):</span>
                                                    </div>
                                                    <div class="flex items-center space-x-3">
                                                        <span class="font-bold">${grade0}</span>
                                                        <span class="text-xs text-gray-400">(${this.getAttribute('data-percent0')}%)</span>
                                                    </div>
                                                </div>`;
                        }

                        tooltipContent += `
                                            </div>
                                            <div class="mt-3 pt-2 border-t border-gray-700">
                                                <div class="flex justify-between font-semibold mb-1">
                                                    <span>Средний балл:</span>
                                                    <span class="text-lg ${averageGrade >= 4.0 ? 'text-green-400' : (averageGrade >= 3.0 ? 'text-yellow-400' : 'text-red-400')}">
                                                        ${averageGrade}
                                                    </span>
                                                </div>
                                                <div class="flex justify-between">
                                                    <span>Итоговая оценка:</span>
                                                    <span class="font-bold ${finalGrade < 3 ? 'text-red-400' : 'text-green-400'}">
                                                        ${finalGrade}
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="tooltip-arrow"></div>`;
                    } else if (type === 'absences') {
                        // Генерируем контент для пропусков
                        const subjectName = this.getAttribute('data-subject-name');
                        const totalAbsences = this.getAttribute('data-total-absences');
                        const absentH = this.getAttribute('data-absent-h');
                        const absentU = this.getAttribute('data-absent-u');
                        const absentB = this.getAttribute('data-absent-b');
                        const totalLessons = this.getAttribute('data-total-lessons');

                        tooltipContent = `
                                            <div class="font-semibold mb-2 border-b pb-1 border-gray-700">Детализация пропусков по предмету:</div>
                                            <div class="text-gray-300 mb-1">${subjectName}</div>
                                            <div class="space-y-2 mb-3">
                                                <div class="flex justify-between items-center">
                                                    <span class="text-red-300">Неуважительные (Н):</span>
                                                    <span class="font-bold">${absentH}</span>
                                                </div>
                                                <div class="flex justify-between items-center">
                                                    <span class="text-yellow-300">Уважительные (У):</span>
                                                    <span class="font-bold">${absentU}</span>
                                                </div>
                                                <div class="flex justify-between items-center">
                                                    <span class="text-blue-300">Болезнь (Б):</span>
                                                    <span class="font-bold">${absentB}</span>
                                                </div>
                                            </div>
                                            <div class="mt-3 pt-2 border-t border-gray-700">
                                                <div class="flex justify-between mb-1">
                                                    <span>Всего пропусков:</span>
                                                    <span class="font-bold">${totalAbsences}</span>
                                                </div>`;

                        if (totalLessons > 0) {
                            const attendanceRate = 100 - (totalAbsences / totalLessons * 100);
                            tooltipContent += `
                                                <div class="flex justify-between mb-1">
                                                    <span>Всего уроков:</span>
                                                    <span class="font-bold">${totalLessons}</span>
                                                </div>
                                                <div class="flex justify-between">
                                                    <span>Посещаемость:</span>
                                                    <span class="font-bold">${attendanceRate.toFixed(1)}%</span>
                                                </div>`;
                        }

                        tooltipContent += `
                                            </div>
                                            <div class="tooltip-arrow"></div>`;
                    }

                    // Устанавливаем контент
                    tooltip.innerHTML = tooltipContent;

                    // Показываем тултип
                    tooltip.classList.add('show');
                    tooltipVisible = true;

                    // Позиционируем тултип
                    positionTooltip(e);
                });

                // При движении мыши над триггером
                trigger.addEventListener('mousemove', function (e) {
                    if (tooltipVisible && currentTrigger === this) {
                        positionTooltip(e);
                    }
                });

                // При уходе мыши
                trigger.addEventListener('mouseleave', function () {
                    if (tooltipVisible && currentTrigger === this) {
                        tooltip.classList.remove('show');
                        tooltipVisible = false;
                        currentTrigger = null;
                    }
                });
            });

            // Функция для позиционирования тултипа
            function positionTooltip(e) {
                if (!tooltipVisible || !currentTrigger) return;

                // Получаем координаты мыши
                const mouseX = e.clientX;
                const mouseY = e.clientY;

                // Получаем размеры тултипа
                const tooltipRect = tooltip.getBoundingClientRect();
                const viewportWidth = window.innerWidth;
                const viewportHeight = window.innerHeight;

                // Начальные координаты (рядом с курсором)
                let left = mouseX + 15;
                let top = mouseY + 15;

                // Проверяем, не выходит ли тултип за правый край
                if (left + tooltipRect.width > viewportWidth - 10) {
                    left = mouseX - tooltipRect.width - 15;
                }

                // Проверяем, не выходит ли тултип за левый край
                if (left < 10) {
                    left = 10;
                }

                // Проверяем, не выходит ли тултип за нижний край
                if (top + tooltipRect.height > viewportHeight - 10) {
                    top = mouseY - tooltipRect.height - 15;
                }

                // Проверяем, не выходит ли тултип за верхний край
                if (top < 10) {
                    top = 10;
                }

                // Устанавливаем позицию
                tooltip.style.left = left + 'px';
                tooltip.style.top = top + 'px';
                tooltip.style.right = 'auto';
                tooltip.style.bottom = 'auto';
                tooltip.style.transform = 'none';
            }

            // Обработчики для глобальных событий
            document.addEventListener('scroll', function () {
                if (tooltipVisible) {
                    tooltip.classList.remove('show');
                    tooltipVisible = false;
                    currentTrigger = null;
                }
            });

            window.addEventListener('resize', function () {
                if (tooltipVisible) {
                    tooltip.classList.remove('show');
                    tooltipVisible = false;
                    currentTrigger = null;
                }
            });

            // Закрытие тултипов при клике вне их
            document.addEventListener('click', function (e) {
                if (tooltipVisible && !e.target.closest('.tooltip-trigger') && !tooltip.contains(e.target)) {
                    tooltip.classList.remove('show');
                    tooltipVisible = false;
                    currentTrigger = null;
                }
            });
        });
    </script>
}
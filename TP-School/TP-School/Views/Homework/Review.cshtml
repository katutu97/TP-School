@model TP_School.ViewModels.HomeworkReviewViewModel

@{
    ViewData["Title"] = "Проверка домашнего задания";
}

<div class="bg-white rounded-lg shadow p-6 mb-6">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
        <h2 class="text-xl font-semibold text-gray-700 mb-4 md:mb-0">
            @if (Model.SelectedClassName != null)
            {
                <span>Текущий класс: @Model.SelectedClassName</span>
            }
        </h2>
        
        <div class="flex items-center space-x-2">
            <label for="classSelector" class="text-sm font-medium text-gray-700 whitespace-nowrap">Сортировка по классу:</label>
            <select id="classSelector" 
                    class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 min-w-[150px]"
                    onchange="filterByClass()">
                @if (Model.AvailableClasses != null && Model.AvailableClasses.Any())
                {
                    @foreach (var classEntry in Model.AvailableClasses)
                    {
                        <option value="@classEntry.Key"
                                selected="@(Model.SelectedClassId == classEntry.Key)">
                            @classEntry.Value
                        </option>
                    }
                }
                else
                {
                    <option value="">Нет доступных классов</option>
                }
            </select>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
{
    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-6">
        <div class="flex">
            <div class="ml-3">
                <p class="text-sm text-yellow-700">
                    @ViewBag.ErrorMessage
                </p>
            </div>
        </div>
    </div>
}

@if (Model.Submissions == null || !Model.Submissions.Any())
{
    <div class="p-8 text-center bg-white rounded-lg shadow">
        <i class="fas fa-folder-open text-6xl text-gray-300 mb-4"></i>
        <p class="text-xl text-gray-500">Нет заданий на проверку для класса @Model.SelectedClassName.</p>
    </div>
}
else
{
    <div class="bg-white rounded-lg shadow-lg overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ФИО Ученика</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Предмет | Урок</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Дата сдачи</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Просмотр ДЗ</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/4">Комментарий учителя</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-24">Оценка</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-24">Действие</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @foreach (var item in Model.Submissions)
                {
                    <tr id="row-@item.HomeworkId">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                            @item.StudentFullName
                            <div class="text-xs text-gray-500">(@item.ClassName)</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            @item.SubjectName
                            <div class="text-xs text-gray-400">@item.LessonDate.ToString("dd.MM") | Урок @item.LessonNumber</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            @item.SubmissionDate.ToString("dd.MM.yyyy HH:mm")
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                            @if (!string.IsNullOrEmpty(item.StudentAnswer))
                            {
                                <button onclick="viewTextHomework(@item.HomeworkId, '@item.StudentFullName.Replace("'", "\\'").Replace("\"", "")', '@item.StudentAnswer.Replace("'", "\\'")')"
                                        class="text-blue-600 hover:text-blue-900 mr-2">
                                    <i class="fas fa-file-alt"></i> Текст
                                </button>
                            }
                            @if (item.HasFile)
                            {
                                <a href="@Url.Action("DownloadFile", "Homework", new { homeworkId = item.HomeworkId })"
                                   class="text-green-600 hover:text-green-900">
                                    <i class="fas fa-download"></i> Файл
                                </a>
                            }
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-500">
                            <textarea id="comment-@item.HomeworkId" rows="2" 
                                      class="form-textarea mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50">@item.CurrentTeacherComment</textarea>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            <select id="grade-@item.HomeworkId" class="border border-gray-300 rounded-lg p-2 w-full">

                                <option value="" selected="@(item.CurrentGradeValue == null)">Н/О</option>

                                @for (int i = 5; i >= 1; i--)
                                {
                                    <option value="@i" selected="@(item.CurrentGradeValue == i)">@i</option>
                                }
                            </select>
                            <input type="hidden" id="gradeid-@item.HomeworkId" value="@item.GradeId" />
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <button onclick="saveReview(@item.HomeworkId)"
                                    class="bg-green-500 text-white px-3 py-1 rounded-lg hover:bg-green-600 transition text-xs flex items-center justify-center">
                                <i class="fas fa-save mr-1"></i> Сохранить
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


<div id="textModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-black bg-opacity-50">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-3xl">
            <div class="flex justify-between items-center p-6 border-b border-gray-200">
                <h3 class="text-xl font-semibold text-gray-800" id="textModalTitle">Ответ ученика: </h3>
                <button type="button" onclick="closeTextModal()"
                        class="text-gray-400 hover:text-gray-600 transition">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>
            
            <div class="p-6">
                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Текст ответа:</label>
                    <div class="p-4 bg-gray-50 rounded border border-gray-200 min-h-[150px] whitespace-pre-wrap">
                        <p id="modalAnswerText" class="text-gray-700"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Получаем токен для безопасности
    const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    // Функция для фильтрации по классу
    function filterByClass() {
        const selectedClassId = document.getElementById('classSelector').value;
        if (selectedClassId) {
            // Переходим на страницу Review нового контроллера Homework
            window.location.href = '@Url.Action("Review", "Homework")' + '?classId=' + selectedClassId;
        }
    }

    // Функция для открытия модального окна текстового ответа
    function viewTextHomework(homeworkId, studentName, answerText) {
        document.getElementById('textModalTitle').innerText = 'Ответ ученика: ' + studentName;
        // Заменяем \\n на реальные переносы строк для корректного отображения
        const formattedText = answerText.replace(/\\n/g, '\n'); 
        document.getElementById('modalAnswerText').innerText = formattedText;
        document.getElementById('textModal').classList.remove('hidden');
    }

    // Функция для закрытия модального окна
    function closeTextModal() {
        document.getElementById('textModal').classList.add('hidden');
    }

    // Функция для сохранения оценки и комментария
    async function saveReview(homeworkId) {
        if (!antiForgeryToken) {
            alert('Ошибка безопасности: Токен не найден.');
            return;
        }

        const gradeElement = document.getElementById(`grade-${homeworkId}`);
        const commentElement = document.getElementById(`comment-${homeworkId}`);
        const gradeIdElement = document.getElementById(`gradeid-${homeworkId}`);

        // Преобразуем "Н/О" (пустую строку) в null
        const gradeValue = gradeElement.value === "" ? null : parseInt(gradeElement.value);
        const comment = commentElement.value;
        const existingGradeId = gradeIdElement.value === "" ? null : parseInt(gradeIdElement.value);

        try {
            const response = await fetch('@Url.Action("SaveReview", "Homework")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    // Добавляем токен
                    'RequestVerificationToken': antiForgeryToken
                },
                body: JSON.stringify({
                    homeworkId: homeworkId,
                    gradeValue: gradeValue,
                    comment: comment,
                    existingGradeId: existingGradeId
                })
            });

            const result = await response.json();

            const row = document.getElementById(`row-${homeworkId}`);
            
            if (result.success) {
                // Если был создан новый Grade, обновляем скрытое поле GradeId
                if (result.newGradeId) {
                    gradeIdElement.value = result.newGradeId;
                }
                
                // Визуальное подтверждение сохранения
                row.style.transition = 'background-color 0.3s';
                row.style.backgroundColor = '#d1fae5'; // Светло-зеленый
                
                setTimeout(() => {
                    row.style.backgroundColor = ''; // Сброс
                }, 1500);
            } else {
                row.style.transition = 'background-color 0.3s';
                row.style.backgroundColor = '#fee2e2'; // Светло-красный
                alert('Ошибка: ' + result.message);
                setTimeout(() => {
                    row.style.backgroundColor = ''; // Сброс
                }, 1500);
            }

        } catch (error) {
            console.error('Ошибка сохранения:', error);
            alert('Произошла ошибка сети или сервера.');
        }
    }
</script>
}
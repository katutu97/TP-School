@model TP_School.ViewModels.UserCreateViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

<div class="modal-overlay hidden" id="editUserModal" style="display: none;">
    <div class="modal-content-details w-11/12 md:w-3/5 lg:w-2/3 xl:w-1/2">
        <div class="flex justify-between items-center mb-4">
            <h3 class="modal-form-header text-2xl font-semibold text-gray-800">
                <i class="fas fa-user-edit mr-2"></i>Редактирование пользователя
            </h3>
            <button type="button" class="text-gray-400 hover:text-gray-600 close-edit-modal">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>

        <div id="editUserModalContent" class="py-4 max-h-[70vh] overflow-y-auto">
            <!-- Контент будет загружаться через AJAX -->
            <div class="text-center py-8">
                <i class="fas fa-spinner fa-spin text-3xl text-indigo-600 mb-3"></i>
                <p class="text-gray-600">Загрузка данных...</p>
            </div>
        </div>
    </div>
</div>
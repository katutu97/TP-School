
@{
    // Мы будем использовать специальный "чистый" макет
    // или установить null, чтобы убрать все лишнее.
    Layout = "_LoginLayout"; // Предположим, вы создадите _LoginLayout.cshtml
    ViewData["Title"] = "Вход в систему";
}

<div class="login-container">
    <div class="logo-box">
        <h1 class="logo-text">ШкЭД</h1>
    </div>

    <div class="login-card shadow p-4 p-md-5">
        <h2 class="text-center mb-4">Вход в систему</h2>

        <form asp-controller="Account" asp-action="Login" method="post">
            <div class="mb-3">
                <input type="text" class="form-control form-control-lg" name="Login" placeholder="Логин" required>
            </div>
            <div class="mb-4">
                <input type="password" class="form-control form-control-lg" name="Password" placeholder="Пароль" required>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">Войти</button>
        </form>

        @* Отображение ошибки *@
        @if (ViewData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mt-3">@ViewData["ErrorMessage"]</div>
        }
    </div>
</div>

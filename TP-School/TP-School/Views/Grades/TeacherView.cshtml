@model TP_School.ViewModels.TeacherClassGradesViewModel
@{
    ViewData["Title"] = "Успеваемость учеников";
}

@* Фильтры для учителя *@
<div class="bg-white rounded-lg shadow p-4 mb-4">
    <form asp-action="Index" method="get" class="space-y-4 md:space-y-0 md:grid md:grid-cols-4 md:gap-4">
        @* Фильтр по классу *@
        <div>
            <label for="classId" class="block text-sm font-medium text-gray-700 mb-1">Класс:</label>
            <select name="classId" id="classId" onchange="this.form.submit()"
                    class="w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-primary focus:border-primary sm:text-sm rounded-md">
                @foreach (var cls in Model.AvailableClasses)
                {
                    <option value="@cls.Key" selected="@(Model.SelectedClassId == cls.Key)">@cls.Value</option>
                }
            </select>
        </div>

        @* Фильтр по предмету *@
        <div>
            <label for="subjectId" class="block text-sm font-medium text-gray-700 mb-1">Предмет:</label>
            <select name="subjectId" id="subjectId" onchange="this.form.submit()"
                    class="w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-primary focus:border-primary sm:text-sm rounded-md">
                @foreach (var subject in Model.AvailableSubjects)
                {
                    <option value="@subject.Key" selected="@(Model.SelectedSubjectId == subject.Key)">@subject.Value</option>
                }
            </select>
        </div>

        @* Фильтр по четверти *@
        <div>
            <label for="quarter" class="block text-sm font-medium text-gray-700 mb-1">Период:</label>
            <select name="quarter" id="quarter" onchange="this.form.submit()"
                    class="w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-primary focus:border-primary sm:text-sm rounded-md">
                @foreach (var q in Model.AvailableQuarters)
                {
                    <option value="@q" selected="@(Model.SelectedQuarter == q)">
                        @if (q == "Итоговые оценки")
                        {
                            <span>@q</span>
                        }
                        else
                        {
                            <span>@q четверть</span>
                        }
                    </option>
                }
            </select>
        </div>

        @* Кнопка применения фильтров *@
        <div class="flex items-end">
            <button type="submit" class="w-full bg-primary hover:bg-primary-dark text-white font-medium py-2 px-4 rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
                Применить
            </button>
        </div>
    </form>
</div>

@* Информация о выбранных фильтрах *@
<div class="bg-white rounded-lg shadow p-4 mb-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
            <p class="text-sm text-gray-600">Класс:</p>
            <p class="text-lg font-semibold">@Model.SelectedClassName</p>
        </div>
        <div>
            <p class="text-sm text-gray-600">Предмет:</p>
            <p class="text-lg font-semibold">@Model.SelectedSubjectName</p>
        </div>
        <div>
            <p class="text-sm text-gray-600">Период:</p>
            <p class="text-lg font-semibold">
                @if (Model.SelectedQuarter == "Итоговые оценки")
                {
                    <span>Итоговые оценки (Год)</span>
                }
                else
                {
                    <span>@Model.SelectedQuarter четверть</span>
                }
            </p>
        </div>
    </div>
</div>

@* Таблица с данными учеников *@
<div class="bg-white rounded-lg shadow overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    №
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    ФИО ученика
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    @if (Model.SelectedQuarter == "Итоговые оценки")
                    {
                        <span>Ср. балл итоговых (Год)</span>
                    }
                    else
                    {
                        <span>Средний балл (Четверть)</span>
                    }
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    @if (Model.SelectedQuarter == "Итоговые оценки")
                    {
                        <span class="font-bold">Годовая Оценка</span>
                    }
                    else
                    {
                        <span class="font-bold">Итоговая Оценка</span>
                    }
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Пропуски
                </th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
            @if (Model.Students.Any())
            {
                var counter = 1;
                @foreach (var student in Model.Students)
                {
                    <tr class="hover:bg-gray-100 transition-colors">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                            @counter
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                            @student.FullName
                        </td>

                        @* Ячейка со средним баллом и тултипом *@
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-bold relative group
                                @(student.QuarterFinalGrade >= 4.0 ? "text-green-600" : (student.QuarterFinalGrade >= 3.0 ? "text-yellow-600" : "text-red-600"))">
                            <div class="cursor-help hover:underline transition-colors inline-block">
                                @student.AverageGrade.ToString("F2")
                                @if (student.GradeCount > 0)
                                {
                                    <span class="text-xs text-gray-400 ml-1">(наведите для деталей)</span>
                                }
                            </div>

                            @* Тултип с детализацией оценок *@
                            @if (student.GradeCount > 0)
                            {
                                <div class="absolute z-50 hidden group-hover:block bg-gray-800 text-white text-sm rounded-lg px-4 py-3 shadow-xl min-w-[300px] transform -translate-x-1/2 left-1/2 mt-2">
                                    <div class="font-semibold mb-2 border-b pb-1">Детализация оценок ученика:</div>
                                    <div class="text-gray-300 mb-1">@student.FullName</div>

                                    <div class="mb-2">
                                        <div class="text-gray-300 mb-1">Всего оценок: <span class="font-bold text-white">@student.GradeCount</span></div>
                                        <div class="text-sm text-gray-400">Все оценки: <span class="font-bold">[@student.AllGradesString]</span></div>
                                    </div>

                                    <div class="space-y-2 mb-3">
                                        <div class="flex justify-between items-center">
                                            <div class="flex items-center">
                                                <span class="w-4 h-4 bg-green-500 rounded mr-2"></span>
                                                <span>Отлично (5):</span>
                                            </div>
                                            <div class="flex items-center space-x-3">
                                                <span class="font-bold">@student.GradeCount5</span>
                                                <span class="text-xs text-gray-400">(@student.Percent5.ToString("F1")%)</span>
                                            </div>
                                        </div>
                                        <div class="flex justify-between items-center">
                                            <div class="flex items-center">
                                                <span class="w-4 h-4 bg-blue-500 rounded mr-2"></span>
                                                <span>Хорошо (4):</span>
                                            </div>
                                            <div class="flex items-center space-x-3">
                                                <span class="font-bold">@student.GradeCount4</span>
                                                <span class="text-xs text-gray-400">(@student.Percent4.ToString("F1")%)</span>
                                            </div>
                                        </div>
                                        <div class="flex justify-between items-center">
                                            <div class="flex items-center">
                                                <span class="w-4 h-4 bg-yellow-500 rounded mr-2"></span>
                                                <span>Удовлетворительно (3):</span>
                                            </div>
                                            <div class="flex items-center space-x-3">
                                                <span class="font-bold">@student.GradeCount3</span>
                                                <span class="text-xs text-gray-400">(@student.Percent3.ToString("F1")%)</span>
                                            </div>
                                        </div>
                                        <div class="flex justify-between items-center">
                                            <div class="flex items-center">
                                                <span class="w-4 h-4 bg-red-500 rounded mr-2"></span>
                                                <span>Неудовлетворительно (2):</span>
                                            </div>
                                            <div class="flex items-center space-x-3">
                                                <span class="font-bold">@student.GradeCount2</span>
                                                <span class="text-xs text-gray-400">(@student.Percent2.ToString("F1")%)</span>
                                            </div>
                                        </div>
                                        @if (student.GradeCount1 > 0)
                                        {
                                            <div class="flex justify-between items-center">
                                                <div class="flex items-center">
                                                    <span class="w-4 h-4 bg-red-700 rounded mr-2"></span>
                                                    <span>Очень плохо (1):</span>
                                                </div>
                                                <div class="flex items-center space-x-3">
                                                    <span class="font-bold">@student.GradeCount1</span>
                                                    <span class="text-xs text-gray-400">(@student.Percent1.ToString("F1")%)</span>
                                                </div>
                                            </div>
                                        }
                                        @if (student.GradeCount0 > 0)
                                        {
                                            <div class="flex justify-between items-center">
                                                <div class="flex items-center">
                                                    <span class="w-4 h-4 bg-gray-700 rounded mr-2"></span>
                                                    <span>Нулевые (0):</span>
                                                </div>
                                                <div class="flex items-center space-x-3">
                                                    <span class="font-bold">@student.GradeCount0</span>
                                                    <span class="text-xs text-gray-400">(@student.Percent0.ToString("F1")%)</span>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <div class="mt-3 pt-2 border-t border-gray-700">
                                        <div class="flex justify-between font-semibold">
                                            <span>Средний балл:</span>
                                            <span class="text-lg @(student.AverageGrade >= 4.0 ? "text-green-400" : (student.AverageGrade >= 3.0 ? "text-yellow-400" : "text-red-400"))">
                                                @student.AverageGrade.ToString("F2")
                                            </span>
                                        </div>
                                        <div class="flex justify-between mt-1">
                                            <span>Итоговая оценка:</span>
                                            <span class="font-bold @(student.QuarterFinalGrade < 3 ? "text-red-400" : "text-green-400")">
                                                @student.QuarterFinalGrade
                                            </span>
                                        </div>
                                    </div>

                                    <div class="absolute -top-2 left-1/2 transform -translate-x-1/2 w-0 h-0 border-l-8 border-l-transparent border-r-8 border-r-transparent border-b-8 border-b-gray-800"></div>
                                </div>
                            }
                        </td>

                        <td class="px-6 py-4 whitespace-nowrap font-extrabold text-lg @(student.QuarterFinalGrade < 3 ? "text-red-600" : "text-green-600")">
                            @student.QuarterFinalGrade
                        </td>

                        @* Ячейка с пропусками и тултипом *@
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 relative group">
                            <div class="cursor-help hover:text-blue-600 transition-colors inline-block">
                                @student.TotalAbsences
                                @if (student.TotalAbsences > 0)
                                {
                                    <span class="text-xs text-gray-400 ml-1">(наведите для деталей)</span>
                                }
                            </div>

                            @* Тултип с детализацией пропусков *@
                            @if (student.TotalAbsences > 0)
                            {
                                <div class="absolute z-50 hidden group-hover:block bg-gray-800 text-white text-sm rounded-lg px-4 py-3 shadow-xl min-w-[250px] transform -translate-x-1/2 left-1/2 mt-2">
                                    <div class="font-semibold mb-2 border-b pb-1">Детализация пропусков:</div>
                                    <div class="text-gray-300 mb-1">@student.FullName</div>

                                    <div class="space-y-1">
                                        <div class="flex justify-between">
                                            <span class="text-red-300">Неуважительные (Н):</span>
                                            <span class="font-bold">@student.AbsentTypeH</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-yellow-300">Уважительные (У):</span>
                                            <span class="font-bold">@student.AbsentTypeU</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-blue-300">Болезнь (Б):</span>
                                            <span class="font-bold">@student.AbsentTypeB</span>
                                        </div>
                                    </div>

                                    <div class="mt-3 pt-2 border-t border-gray-700">
                                        <div class="flex justify-between">
                                            <span>Всего пропусков:</span>
                                            <span class="font-bold">@student.TotalAbsences</span>
                                        </div>
                                        @if (student.TotalLessonsInPeriod > 0)
                                        {
                                            <div class="flex justify-between mt-1">
                                                <span>Всего уроков:</span>
                                                <span class="font-bold">@student.TotalLessonsInPeriod</span>
                                            </div>
                                            <div class="flex justify-between mt-1">
                                                <span>Посещаемость:</span>
                                                <span class="font-bold">
                                                    @{
                                                        var attendanceRate = 100 - ((double)student.TotalAbsences / student.TotalLessonsInPeriod * 100);
                                                        @($"{attendanceRate:F1}%")
                                                    }
                                                </span>
                                            </div>
                                        }
                                    </div>

                                    <div class="absolute -top-2 left-1/2 transform -translate-x-1/2 w-0 h-0 border-l-8 border-l-transparent border-r-8 border-r-transparent border-b-8 border-b-gray-800"></div>
                                </div>
                            }
                        </td>
                    </tr>
                    counter++;
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="px-6 py-4 text-center text-gray-500">
                        Нет данных об успеваемости для выбранных фильтров.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Автоматическая отправка формы при изменении фильтров
            const filters = document.querySelectorAll('#classId, #subjectId, #quarter');
            filters.forEach(filter => {
                filter.addEventListener('change', function () {
                    this.form.submit();
                });
            });

            // Закрытие тултипов при клике вне их
            document.addEventListener('click', function (e) {
                const tooltips = document.querySelectorAll('.absolute.z-50');
                if (!e.target.closest('.relative.group')) {
                    tooltips.forEach(tooltip => {
                        tooltip.classList.add('hidden');
                    });
                }
            });
        });
    </script>
}